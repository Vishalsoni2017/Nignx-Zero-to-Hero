After add record on dns servers 
A type of Subdomain and IP in value or target column

# Subdomain configuration for dev.unemployengineer.works
server {
    listen 80;
    server_name dev.unemployengineer.works;

    root /var/www/dev.unemployengineer.works/html;
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }
}

