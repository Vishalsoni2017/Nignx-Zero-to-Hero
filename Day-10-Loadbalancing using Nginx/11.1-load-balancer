SetUp LoadBalancer and add reverse proxy on nginx server

setup lb.unemployengineer.works on dns server
Add record a type with lb and public ip of server


0. Install node 
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash &&
    source ~/.bashrc &&
    nvm install --lts &&
    node -v



1. # Create site config
    sudo nano /etc/nginx/sites-available/lb.unemployengineer.works //your-website-name

2. Add server block

    upstream backend_servers{
        server private_ip:port;
        server private_ip:port;
    }

    server {
    listen 80;
    server_name lb.unemployengineer.works;
    
    location / {
    proxy_pass http://backend_servers; 
    proxy_set_header Host $host; 
     proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; 
    proxy_set_header X-Forwarded-Proto $scheme 
    }


    error_log /var/log/nginx/site1.unemployengineer.works_error_log.log;
    access_log /var/log/nginx/site1.unemployengineer.works_access_log.log;

    }


3. # Enable site
    sudo ln -s /etc/nginx/sites-available/unemployengineer.works /etc/nginx/sites-enabled/   
    
4. Reload and test
sudo nginx -t && sudo systemctl reload nginx


